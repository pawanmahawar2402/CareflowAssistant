# ── LLM provider (pick one) ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ── LiteLLM model aliases ──────────────────────────────────────────────────
# Maps the provider-agnostic alias used throughout the app to a real model.
CAREFLOW_LLM_MODEL=gemini/gemini-3.5-flash-lite
CAREFLOW_FALLBACK_LLM_MODEL=gemini/gemini-3.5-flash
CAREFLOW_EMBED_MODEL=gemini/gemini-embedding-001

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=careflow_corpus

# ── Redis (session memory) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LangFuse (M7 observability) ────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Data directory ─────────────────────────────────────────────────────────
# Points at the output of: python generate_data.py
CAREFLOW_DATA_DIR=./data

# ── Circuit breaker ────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
